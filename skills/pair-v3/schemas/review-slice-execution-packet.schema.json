{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pair v4 Review Slice Execution Packet",
  "type": "object",
  "properties": {
    "schema": { "const": 1 },
    "work_id": { "type": "string", "pattern": "^work-[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "plan": { "$ref": "#/$defs/digest_reference" },
    "implementation_design": {
      "type": "object",
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^EVD-[0-9]{3}-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["evidence_id", "path", "sha256"],
      "additionalProperties": false
    },
    "review_slice": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "outcome": { "$ref": "#/$defs/text" },
        "profile": {
          "type": "object",
          "properties": {
            "type": { "enum": ["bugfix", "feature", "refactor", "test", "docs", "migration"] },
            "complexity": { "enum": ["S", "M", "L"] },
            "risk": { "enum": ["low", "medium", "high", "critical"] },
            "scope": { "enum": ["local", "cross-module", "contract", "architecture"] },
            "uncertainty": { "enum": ["low", "medium", "high"] }
          },
          "required": ["type", "complexity", "risk", "scope", "uncertainty"],
          "additionalProperties": false
        },
        "acceptance_criteria": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "properties": { "id": { "type": "string", "pattern": "^AC-[1-9][0-9]*$" }, "text": { "$ref": "#/$defs/text" } },
            "required": ["id", "text"], "additionalProperties": false
          }
        },
        "constraints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "repository_evidence": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "symbols": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" }, "uniqueItems": true }
            },
            "required": ["path", "symbols"], "additionalProperties": false
          }
        },
        "owned_files": { "$ref": "#/$defs/paths" },
        "test_files": { "$ref": "#/$defs/paths" },
        "consumes": { "type": "array" },
        "produces": { "type": "array" },
        "implementation_decisions": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "implementation-design.schema.json#/$defs/decision" }
        },
        "dependency_decisions": {
          "type": "array",
          "items": { "$ref": "implementation-design.schema.json#/$defs/decision" }
        },
        "non_goals": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "verification": { "$ref": "#/$defs/text" }
      },
      "required": ["id", "outcome", "profile", "acceptance_criteria", "constraints", "repository_evidence", "owned_files", "test_files", "consumes", "produces", "implementation_decisions", "dependency_decisions", "non_goals", "verification"],
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "properties": {
        "cheap_ready": { "type": "boolean" },
        "recommended_strength": { "type": "integer", "minimum": 1, "maximum": 4 },
        "reasons": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "packet_bytes": { "type": "integer", "minimum": 1, "maximum": 16384 }
      },
      "required": ["cheap_ready", "recommended_strength", "reasons", "packet_bytes"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "work_id", "plan", "implementation_design", "review_slice", "routing"],
  "additionalProperties": false,
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "path": { "type": "string", "pattern": "^(?!/|~)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
    "paths": { "type": "array", "items": { "$ref": "#/$defs/path" }, "uniqueItems": true },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "digest_reference": {
      "type": "object",
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/sha256" } },
      "required": ["path", "sha256"], "additionalProperties": false
    }
  }
}
