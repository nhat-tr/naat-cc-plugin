#!/usr/bin/env node

const childProcess = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const { takeoverWork } = require('./lib/handover-takeover');
const {
  adoptAgentConversationHandover,
  authorizeColdResume,
  conversationIdentity,
  ensureBrainstormingRegistration,
  formatFreshnessProjection,
  freshnessProjection,
  readAgentConversationHandover,
  readAgentConversationHandoverForAdoption,
  readAgentConversationRegistry,
  registerAgentConversation,
  sealAgentConversationHandover,
  setGeneralHandoverPolicy,
  updateAgentConversationCheckpoint,
  validateAgentConversationCheckpointInput,
} = require('./lib/handover-state');
const { readJson, redactString, repositoryRoot } = require('./lib/pair-store');
const { resolveRuntime } = require('./lib/runtime-selection');

const NESTED_SESSION_ENV_KEYS = [
  'CODEX_THREAD_ID', 'CLAUDECODE', 'CLAUDE_CODE', 'CLAUDE_CODE_CHILD_SESSION',
  'CLAUDE_CODE_BRIDGE_SESSION_ID', 'CLAUDE_CODE_PARENT_SESSION_ID', 'CLAUDE_CODE_SESSION_ID',
  'CLAUDE_SESSION_ID', 'CLAUDE_SESSION_ID_OVERRIDE', 'CLAUDE_CODE_ENTRYPOINT',
  'CLAUDE_CODE_EXECPATH', 'CLAUDE_CODE_SSE_PORT',
];

function fail(message) {
  console.error(`pair-loop: ${message}`);
  process.exitCode = 1;
}

function parseArgs(argv) {
  const options = {
    runtime: 'auto',
    once: false,
    confirmCostRisk: false,
    brainstormCheckpoint: false,
    registerBrainstorming: false,
    conversationCheckpoint: false,
    handoverNow: false,
    handoverHelp: false,
    generalHandoverPolicy: null,
    freshnessStatus: false,
    pairControl: false,
  };
  for (let index = 0; index < argv.length; index++) {
    const arg = argv[index];
    if (arg === '--runtime') options.runtime = argv[++index];
    else if (arg === '--fresh-from') options.freshFrom = argv[++index];
    else if (arg === '--adopt-handover') options.adoptHandover = argv[++index];
    else if (arg === '--allow-cold-resume') options.allowColdResume = argv[++index];
    else if (arg === '--brainstorm-checkpoint') options.brainstormCheckpoint = true;
    else if (arg === '--register-brainstorming') options.registerBrainstorming = true;
    else if (arg === '--conversation-checkpoint') options.conversationCheckpoint = true;
    else if (arg === '--handover-now') options.handoverNow = true;
    else if (arg === '--handover-help') options.handoverHelp = true;
    else if (arg === '--enable-general-handover') options.generalHandoverPolicy = 'auto';
    else if (arg === '--disable-general-handover') options.generalHandoverPolicy = 'off';
    else if (arg === '--freshness-status') options.freshnessStatus = true;
    else if (arg === '--status') options.pairControl = true;
    else if (arg === '--confirm-cost-risk') options.confirmCostRisk = true;
    else if (arg === '--once') options.once = true;
    else if (arg === '--help' || arg === '-h') options.help = true;
    else throw new Error(`unsupported Agent Conversation Handover option ${arg}`);
  }
  if (options.brainstormCheckpoint && options.pairControl) {
    throw new Error('--brainstorm-checkpoint cannot be combined with Pair control options');
  }
  return options;
}

function coordinatorIdentity(env = process.env) {
  const codexId = String(env.CODEX_THREAD_ID || '').trim();
  const claudeId = String(env.CLAUDE_CODE_SESSION_ID || '').trim();
  if (codexId && claudeId) throw new Error('ambiguous native Agent Conversation identity');
  if (codexId) return { runtime: 'codex', agentConversationId: codexId };
  if (claudeId) return { runtime: 'claude', agentConversationId: claudeId };
  return null;
}

function runtimeForNativeConversation(requested, identity) {
  if (!identity) throw new Error('operation requires a native Agent Conversation identity');
  const runtime = requested === 'auto' ? identity.runtime : requested;
  if (!['codex', 'claude'].includes(runtime)) throw new Error(`unsupported runtime ${runtime}`);
  if (runtime !== identity.runtime) throw new Error(`--runtime ${runtime} does not match the active ${identity.runtime} Agent Conversation`);
  return runtime;
}

function runtimeEnv(options = {}) {
  const source = options.sourceEnv || process.env;
  const env = {
    ...source,
    PATH: String(source.PATH || '').split(path.delimiter).filter(entry => entry && !entry.includes('cmux-cli-shims')).join(path.delimiter),
  };
  if (options.disableStopGate !== false) {
    env.PAIR_STOP_GATE = 'off';
    env.CLAUDE_STOP_GATE = 'off';
  } else {
    delete env.PAIR_STOP_GATE;
    delete env.CLAUDE_STOP_GATE;
  }
  for (const key of NESTED_SESSION_ENV_KEYS) delete env[key];
  return env;
}

function runtimeDiagnostic(result) {
  if (result.error) return redactString(`spawn error: ${result.error.message}`);
  const stderr = redactString(result.stderr || '').trim();
  if (stderr) return stderr;
  if (!String(result.stdout || '').trim()) return `runtime exited ${result.status ?? 'null'} with no output`;
  return '';
}

function assertPlainFreshRuntimeCommand(runtime, args) {
  if (!['codex', 'claude'].includes(runtime)) throw new Error(`unsupported runtime ${runtime}`);
  if (!Array.isArray(args) || args.some(arg => /--(?:resume|continue|fork(?:-session)?)(?:=|\b)/iu.test(String(arg)))) {
    throw new Error('fresh Agent Conversation launch rejects resume and fork argv');
  }
}

function liveInFlightRequest(state) {
  return state?.in_flight_request || null;
}

function launchFreshAgentConversation(root, input, dependencies = {}) {
  const env = dependencies.env || process.env;
  if ((dependencies.nested ?? NESTED_SESSION_ENV_KEYS.some(key => Boolean(env[key])))) {
    throw new Error('cannot launch a fresh Agent Conversation from a nested runtime');
  }
  const handover = readAgentConversationHandover(root, input.handoverId);
  if (handover.manifest.pair_work) {
    const referenced = readJson(path.resolve(root, handover.manifest.pair_work.projection_path));
    if (!referenced) throw new Error('invalid handover Pair Work projection');
    if (liveInFlightRequest(referenced)) throw new Error('cannot launch while Pair request is in flight');
  }
  const requested = input.runtime || 'auto';
  const runtime = requested === 'auto'
    ? resolveRuntime(handover.manifest.runtime, { available: input.available, env })
    : resolveRuntime(requested, { available: input.available, env });
  const bootstrap = `Adopt Agent Conversation Handover ${input.handoverId}. Run pair-loop --adopt-handover ${input.handoverId} --runtime ${runtime}, then continue from checkpoint.next_action without requesting old transcript.`;
  if (Buffer.byteLength(bootstrap, 'utf8') > 8192) throw new Error('fresh Agent Conversation bootstrap exceeds 8192 bytes');
  const args = [bootstrap];
  assertPlainFreshRuntimeCommand(runtime, args);
  const child = (dependencies.spawnSync || childProcess.spawnSync)(runtime, args, {
    cwd: root,
    stdio: 'inherit',
    env: runtimeEnv({ sourceEnv: env, disableStopGate: false }),
  });
  if (child.error || child.status !== 0) throw new Error(runtimeDiagnostic(child) || `${runtime} fresh Agent Conversation exited ${child.status}`);
  return { handoverId: input.handoverId, runtime, status: child.status, bootstrap };
}

function adoptFreshAgentConversation(root, input, dependencies = {}) {
  return adoptAgentConversationHandover(root, { ...input, transferContinuation: dependencies.takeoverWork || takeoverWork });
}

function authorizeOneShotColdResume(root, input) {
  if (input.once !== true || input.confirmCostRisk !== true) throw new Error('cold resume requires --once and --confirm-cost-risk');
  return authorizeColdResume(root, input);
}

function readCheckpointInput(command, input) {
  if (input !== null) return input;
  if (process.stdin.isTTY) throw new Error(`${command} does not accept interactive TTY stdin; use ${command} < checkpoint.json`);
  try { return JSON.parse(fs.readFileSync(0, 'utf8') || 'null'); }
  catch { throw new Error(`${command} requires one JSON object on stdin`); }
}

function recordBrainstormCheckpoint(root, options, input = null) {
  const identity = coordinatorIdentity();
  const runtime = runtimeForNativeConversation(options.runtime, identity);
  const checkpoint = readCheckpointInput('--brainstorm-checkpoint', input);
  if (!checkpoint || typeof checkpoint !== 'object' || Array.isArray(checkpoint)) throw new Error('--brainstorm-checkpoint requires one JSON object');
  validateAgentConversationCheckpointInput(checkpoint);
  registerAgentConversation(root, { runtime, agentConversationId: identity.agentConversationId, kind: 'brainstorming' });
  return updateAgentConversationCheckpoint(root, { runtime, agentConversationId: identity.agentConversationId, kind: 'brainstorming', checkpoint });
}

function recordConversationCheckpoint(root, options, input = null) {
  const identity = coordinatorIdentity();
  const runtime = runtimeForNativeConversation(options.runtime, identity);
  const checkpoint = readCheckpointInput('--conversation-checkpoint', input);
  if (!checkpoint || typeof checkpoint !== 'object' || Array.isArray(checkpoint)) throw new Error('--conversation-checkpoint requires one JSON object');
  validateAgentConversationCheckpointInput(checkpoint);
  const sourceKey = conversationIdentity({ runtime, agentConversationId: identity.agentConversationId }).sourceKey;
  const existing = readAgentConversationRegistry(root).conversations[sourceKey];
  if (existing?.kind === 'pair') throw new Error('Pair Agent Conversation Checkpoints derive from repository authority');
  const kind = existing?.kind || 'general';
  if (!existing) registerAgentConversation(root, { runtime, agentConversationId: identity.agentConversationId, kind });
  return updateAgentConversationCheckpoint(root, {
    runtime, agentConversationId: identity.agentConversationId, kind, checkpoint,
    origin: 'manual', acknowledgeUnchanged: true,
  });
}

function registerBrainstormingBootstrap(root, options) {
  const identity = coordinatorIdentity();
  return ensureBrainstormingRegistration(root, {
    runtime: runtimeForNativeConversation(options.runtime, identity),
    agentConversationId: identity.agentConversationId,
  });
}

function sealCurrentAgentConversation(root, options) {
  const identity = coordinatorIdentity();
  const runtime = runtimeForNativeConversation(options.runtime, identity);
  const sourceKey = conversationIdentity({ runtime, agentConversationId: identity.agentConversationId }).sourceKey;
  const conversation = readAgentConversationRegistry(root).conversations[sourceKey];
  if (!conversation) throw new Error('Agent Conversation is not registered');
  return sealAgentConversationHandover(root, { runtime, agentConversationId: identity.agentConversationId, kind: conversation.kind });
}

function handoverHelpText() {
  return `Agent Conversation Handover

Enable: pair-loop --enable-general-handover
Status: pair-loop --freshness-status
Launch fresh: pair-loop --fresh-from <id> --runtime auto
Adopt inside fresh conversation: pair-loop --adopt-handover <id> --runtime codex|claude
Manual checkpoint: pair-loop --conversation-checkpoint < checkpoint.json
Immediate seal: pair-loop --handover-now
One cold-cost recovery turn: pair-loop --allow-cold-resume <id> --once --confirm-cost-risk`;
}

function currentTime(env = process.env) {
  const configured = Number(env.PAIR_NOW_MS);
  return Number.isFinite(configured) && configured >= 0 ? configured : Date.now();
}

function main(argv = process.argv.slice(2)) {
  let options;
  try { options = parseArgs(argv); } catch (error) { fail(error.message); return; }
  if (options.help || options.handoverHelp) { console.log(handoverHelpText()); return; }
  let root;
  try { root = repositoryRoot(process.cwd()); } catch (error) { fail(error.message); return; }
  try {
    if (options.generalHandoverPolicy) {
      setGeneralHandoverPolicy(root, options.generalHandoverPolicy === 'auto');
      console.log(`pair-loop: automatic general Agent Conversation handover ${options.generalHandoverPolicy === 'auto' ? 'enabled' : 'disabled'}`);
    } else if (options.freshnessStatus) {
      console.log(formatFreshnessProjection(freshnessProjection(root, currentTime())));
    } else if (options.conversationCheckpoint) {
      const recorded = recordConversationCheckpoint(root, options);
      console.log(`pair-loop: Agent Conversation Checkpoint r${recorded.revision} recorded`);
    } else if (options.brainstormCheckpoint) {
      const recorded = recordBrainstormCheckpoint(root, options);
      console.log(`pair-loop: brainstorming Agent Conversation Checkpoint r${recorded.revision} recorded`);
    } else if (options.registerBrainstorming) {
      const recorded = registerBrainstormingBootstrap(root, options);
      console.log(recorded.alreadyRegistered ? 'pair-loop: brainstorming Agent Conversation already registered' : `pair-loop: brainstorming Agent Conversation registered with bootstrap checkpoint r${recorded.revision}`);
    } else if (options.handoverNow) {
      const sealed = sealCurrentAgentConversation(root, options);
      console.log(`pair-loop: Agent Conversation Handover ${sealed.handoverId} sealed`);
    } else if (options.freshFrom) {
      const launched = launchFreshAgentConversation(root, { handoverId: options.freshFrom, runtime: options.runtime });
      console.log(`pair-loop: launched fresh ${launched.runtime} Agent Conversation for ${launched.handoverId}`);
    } else if (options.adoptHandover) {
      const identity = coordinatorIdentity();
      const runtime = runtimeForNativeConversation(options.runtime, identity);
      if (options.runtime === 'auto') {
        const handover = readAgentConversationHandoverForAdoption(root, options.adoptHandover, { runtime, agentConversationId: identity.agentConversationId });
        if (handover.manifest.runtime !== runtime) throw new Error(`cross-provider adoption requires explicit --runtime ${runtime}`);
      }
      const adopted = adoptFreshAgentConversation(root, { handoverId: options.adoptHandover, runtime, agentConversationId: identity.agentConversationId });
      console.log(JSON.stringify({ status: 'adopted', handover_id: adopted.handoverId, checkpoint: adopted.checkpoint, recovery_instruction: 'Continue from checkpoint.next_action; do not request old transcript.' }, null, 2));
    } else if (options.allowColdResume) {
      const identity = coordinatorIdentity();
      const authorized = authorizeOneShotColdResume(root, {
        handoverId: options.allowColdResume,
        runtime: runtimeForNativeConversation(options.runtime, identity),
        agentConversationId: identity.agentConversationId,
        once: options.once,
        confirmCostRisk: options.confirmCostRisk,
      });
      console.log(`pair-loop: one cold-cost turn authorized for ${authorized.handoverId}`);
    } else {
      throw new Error('Agent Conversation Handover command is required');
    }
  } catch (error) {
    fail(error.message);
  }
}

if (require.main === module) main();

module.exports = {
  NESTED_SESSION_ENV_KEYS,
  adoptFreshAgentConversation,
  assertPlainFreshRuntimeCommand,
  authorizeOneShotColdResume,
  coordinatorIdentity,
  currentTime,
  handoverHelpText,
  launchFreshAgentConversation,
  liveInFlightRequest,
  parseArgs,
  recordBrainstormCheckpoint,
  recordConversationCheckpoint,
  registerBrainstormingBootstrap,
  resolveRuntime,
  runtimeDiagnostic,
  runtimeEnv,
  sealCurrentAgentConversation,
};
