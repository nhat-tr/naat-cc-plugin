#!/usr/bin/env node

const fs = require('node:fs');
const path = require('node:path');

const {
  pairCommonDirectory,
  readCurrentWork,
  readEvents,
  readJson,
  repositoryRoot,
  workPaths,
} = require('./lib/pair-store');

function parseArgs(argv) {
  const result = { json: false, timeline: false, workId: null };
  for (let index = 0; index < argv.length; index++) {
    const arg = argv[index];
    if (arg === '--json') result.json = true;
    else if (arg === '--timeline') result.timeline = true;
    else if (arg === '--work') result.workId = argv[++index];
    else if (arg === '--help' || arg === '-h') result.help = true;
    else throw new Error(`unsupported option ${arg}`);
  }
  if (result.timeline && !result.workId) throw new Error('--timeline requires --work WORK_ID');
  return result;
}

const TIMELINE_LIMIT_BYTES = 32 * 1024;
const TIMELINE_EVENTS = new Set([
  'work-opened',
  'design-check-recorded',
  'verification-finished',
  'checkpoint-created',
  'review-recorded',
  'review-feedback-recorded',
  'slice-accepted',
  'completion-verification-finished',
  'work-completed',
  'review-guidance-proposed',
  'review-guidance-decided',
]);
const TIMELINE_FIELDS = [
  'sequence', 'at', 'event', 'review_slice_id', 'lifecycle', 'status', 'route',
  'base_commit', 'checkpoint_commit', 'head_commit', 'changed_path_count',
  'review_outcome_id', 'finding_id', 'finding_count', 'verdict', 'disposition',
  'correction_count', 'proposal_id', 'decision',
];

function timeline(events) {
  const selected = events.filter(event => TIMELINE_EVENTS.has(event.event)).map(event => Object.fromEntries(
    TIMELINE_FIELDS.filter(field => event[field] !== undefined && event[field] !== null).map(field => [field, event[field]]),
  ));
  const result = { event_count: selected.length, omitted_event_count: 0, events: selected };
  while (result.events.length > 0 && Buffer.byteLength(JSON.stringify(result), 'utf8') > TIMELINE_LIMIT_BYTES) {
    result.events.shift();
    result.omitted_event_count++;
  }
  return result;
}

function workIds(root, selected) {
  if (selected) return [selected];
  const directory = path.join(pairCommonDirectory(root), 'works');
  if (!fs.existsSync(directory)) return [];
  return fs.readdirSync(directory, { withFileTypes: true })
    .filter(entry => entry.isDirectory())
    .map(entry => entry.name)
    .sort();
}

// The optimization's own falsifiability. A warm session that is never actually resumed, or one whose
// context grows past the budget every round, looks identical to a working one in the token totals — so
// the counts and the per-slice growth curve are stated separately from the money.
function warmSessions(events) {
  const calls = events.filter(event => event.event === 'provider-finished' || event.event === 'provider-failed' || event.event === 'provider-interrupted');
  const rotations = events.filter(event => event.event === 'warm-session-rotated');
  const growth = new Map();
  for (const call of calls) {
    if (!call.review_slice_id || !call.context_tokens) continue;
    if (!growth.has(call.review_slice_id)) growth.set(call.review_slice_id, []);
    growth.get(call.review_slice_id).push(call.context_tokens);
  }
  return {
    warm_calls: calls.filter(call => call.resumed === true).length,
    fresh_calls: calls.filter(call => call.resumed !== true).length,
    sessions_opened: events.filter(event => event.event === 'warm-session-opened').length,
    sessions_retired: events.filter(event => event.event === 'warm-session-retired').length,
    rotations: Object.fromEntries([...new Set(rotations.map(event => event.reason))]
      .map(reason => [reason, rotations.filter(event => event.reason === reason).length])),
    interrupted: events.filter(event => event.event === 'provider-interrupted').length,
    context_growth: Object.fromEntries(growth),
  };
}

function summarize(root, workId, options = {}) {
  const paths = workPaths(root, workId);
  const state = readJson(paths.state);
  if (!state) return null;
  const events = readEvents(root, workId);
  const invocations = state.invocations || events.filter(event => event.event === 'provider-finished');
  const totals = state.invocation_totals || invocations.reduce((sum, invocation) => ({
    calls: sum.calls + 1,
    input_tokens: sum.input_tokens + (invocation.input_tokens || 0),
    cached_input_tokens: sum.cached_input_tokens + (invocation.cached_input_tokens || 0),
    output_tokens: sum.output_tokens + (invocation.output_tokens || 0),
    duration_ms: sum.duration_ms + (invocation.duration_ms || 0),
  }), { calls: 0, input_tokens: 0, cached_input_tokens: 0, output_tokens: 0, duration_ms: 0 });
  const feedback = events.filter(event => event.event === 'review-feedback-recorded');
  const dispositions = Object.fromEntries(['valid', 'false-positive', 'not-worth-fixing', 'missing-context']
    .map(value => [value, feedback.filter(event => event.disposition === value).length]));
  return {
    work_id: workId,
    lifecycle: state.lifecycle,
    branch: state.branch,
    worktree: state.worktree,
    base_commit: state.base_commit,
    head_commit: state.head_commit,
    spec_ref: state.spec_ref,
    manifest_ref: state.manifest_ref,
    next_action: state.next_action,
    slices: state.slices.map(slice => ({
      id: slice.id,
      status: slice.status,
      route: slice.route,
      correction_count: slice.correction_count,
      base_commit: slice.base_commit,
      checkpoint_commit: slice.checkpoint_commit,
    })),
    totals,
    warm_sessions: warmSessions(events),
    review: {
      outcomes: events.filter(event => event.event === 'review-recorded').length,
      findings: events.filter(event => event.event === 'review-recorded').reduce((sum, event) => sum + (event.finding_count || 0), 0),
      dispositions,
    },
    ...(options.timeline ? { timeline: timeline(events) } : {}),
    updated_at: state.updated_at,
  };
}

function render(report) {
  const accepted = report.slices.filter(slice => slice.status === 'accepted').length;
  const lines = [
    `${report.work_id}: ${report.lifecycle}`,
    `  slices ${accepted}/${report.slices.length} accepted; model calls ${report.totals.calls}`,
    `  tokens input ${report.totals.input_tokens}, cached ${report.totals.cached_input_tokens}, output ${report.totals.output_tokens}`,
    `  review outcomes ${report.review.outcomes}, findings ${report.review.findings}; feedback ${JSON.stringify(report.review.dispositions)}`,
  ];
  const warm = report.warm_sessions;
  if (warm) {
    lines.push(`  sessions warm ${warm.warm_calls}/${warm.warm_calls + warm.fresh_calls} calls; opened ${warm.sessions_opened}, retired ${warm.sessions_retired}, rotated ${JSON.stringify(warm.rotations)}`);
    for (const [sliceId, curve] of Object.entries(warm.context_growth)) {
      // The growth curve is the whole claim: 837K → 2.77M → 5.97M across three calls on one slice is what
      // the fresh-spawn loop did, and a warm slice that reads the same way has not fixed anything.
      lines.push(`  ${sliceId} context ${curve.join(' -> ')} tokens`);
    }
  }
  if (report.timeline) {
    lines.push(`  timeline ${report.timeline.event_count} events; ${report.timeline.omitted_event_count} omitted from bounded output`);
    for (const event of report.timeline.events) {
      const slice = event.review_slice_id ? ` ${event.review_slice_id}` : '';
      const detail = event.status !== undefined ? ` status=${event.status}` : event.disposition ? ` ${event.disposition}` : '';
      lines.push(`  ${event.sequence} ${event.at} ${event.event}${slice}${detail}`);
    }
  }
  return lines.join('\n');
}

function main(argv = process.argv.slice(2)) {
  const options = parseArgs(argv);
  if (options.help) {
    console.log('Usage: pair-report [--work WORK_ID] [--timeline] [--json]\n\nSummarize compact Evidence-at-Commit state from the Git common directory. Timeline output is bounded and requires --work.');
    return;
  }
  const root = repositoryRoot(process.cwd());
  const selected = options.workId || (workIds(root).length === 0 ? readCurrentWork(root)?.work_id : null);
  const reports = workIds(root, selected).map(workId => summarize(root, workId, { timeline: options.timeline })).filter(Boolean);
  if (options.json) console.log(JSON.stringify(reports, null, 2));
  else if (reports.length === 0) console.log('pair-report: no Work recorded');
  else console.log(reports.map(render).join('\n\n'));
}

if (require.main === module) {
  try { main(); } catch (error) {
    console.error(`pair-report: ${error.message}`);
    process.exitCode = 1;
  }
}

module.exports = { main, summarize, timeline };
