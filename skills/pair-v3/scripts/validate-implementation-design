#!/usr/bin/env node

const crypto = require('node:crypto');
const fs = require('node:fs');
const path = require('node:path');

const { validateEvidenceFile } = require('../../brainstorming/scripts/work-lineage.cjs');
const { validateImplementationDesignRecord } = require('./lib/implementation-design');

function main() {
  const file = process.argv[2];
  if (file === '--help' || file === '-h') {
    console.log('Usage: validate-implementation-design FILE');
    return;
  }
  if (!file) {
    console.error('Usage: validate-implementation-design FILE');
    process.exit(1);
  }
  const resolved = path.resolve(file);
  const stat = fs.lstatSync(resolved);
  if (!stat.isFile() || stat.isSymbolicLink()) throw new Error('Implementation Design Contract must be a regular non-symbolic file');
  const bytes = fs.readFileSync(resolved);
  const record = validateEvidenceFile(resolved);
  const result = validateImplementationDesignRecord(record);
  for (const warning of result.warnings) console.log(`  ⚠ ${warning}`);
  for (const error of result.errors) console.log(`  ✗ ${error}`);
  if (!result.valid) {
    console.log(`validate-implementation-design: NOT valid (${file})`);
    process.exit(1);
  }
  const digest = crypto.createHash('sha256').update(bytes).digest('hex');
  console.log(`validate-implementation-design: OK — ${record.result.decisions.length} decision(s)`);
  console.log(`implementation design raw sha256: ${digest}`);
}

main();
