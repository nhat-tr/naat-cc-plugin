#!/usr/bin/env node
'use strict';

// Checks a candidate Implementation Design Contract and draft plan while both
// still live in scratch. The Review Slice packet budget is otherwise only
// knowable after the design has been recorded as immutable evidence, so every
// re-slice mints a throwaway EVD record. This runs the same downstream checks
// and prints the per-slice routing table, and persists nothing.
//
// This is NOT the gate of record. Canonical-path, digest-binding, and
// Work-index checks are skipped because they only hold once the evidence
// exists. Run validate-implementation-design + validate-plan after recording.

const childProcess = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const {
  compileReviewSliceExecutionPacket,
  validateImplementationDesignRecord,
  validatePlanImplementationDesign,
} = require('./lib/implementation-design');

function fail(message) {
  console.error(`promote-preflight: ${message}`);
  process.exit(2);
}

function parseArgs(argv) {
  const options = { plan: null, design: null };
  for (let index = 0; index < argv.length; index++) {
    const arg = argv[index];
    if (arg === '--design') options.design = argv[++index];
    else if (arg === '--help' || arg === '-h') {
      console.log('Usage: promote-preflight DRAFT_PLAN --design CANDIDATE_DESIGN_JSON');
      process.exit(0);
    } else if (!options.plan) options.plan = arg;
    else fail(`unexpected argument ${arg}`);
  }
  if (!options.plan) fail('a draft plan path is required');
  if (!options.design) fail('--design CANDIDATE_DESIGN_JSON is required');
  return options;
}

function repositoryRoot(from) {
  const result = childProcess.spawnSync('git', ['-C', from, 'rev-parse', '--show-toplevel'], { encoding: 'utf8' });
  return result.status === 0 ? result.stdout.trim() : process.cwd();
}

function main() {
  const options = parseArgs(process.argv.slice(2));
  for (const file of [options.plan, options.design]) {
    if (!fs.existsSync(file)) fail(`${file} does not exist`);
  }

  const bytes = fs.readFileSync(path.resolve(options.design));
  let record;
  try {
    record = JSON.parse(bytes.toString('utf8'));
  } catch (error) {
    fail(`candidate design is not valid JSON: ${error.message}`);
  }

  // Validate the contract on its own first: a malformed record produces
  // confusing downstream errors.
  const contract = validateImplementationDesignRecord(record);
  for (const warning of contract.warnings) console.log(`  ⚠ ${warning}`);
  for (const error of contract.errors) console.log(`  ✗ ${error}`);

  const planPath = path.resolve(options.plan);
  const plan = fs.readFileSync(planPath, 'utf8');
  const root = repositoryRoot(path.dirname(planPath));
  const candidateDesign = { path: options.design, bytes, record };

  const result = validatePlanImplementationDesign({ root, planPath, plan, candidateDesign });
  for (const warning of result.warnings) console.log(`  ⚠ ${warning}`);
  for (const error of result.errors) console.log(`  ✗ ${error}`);

  if (!result.valid || !contract.valid) {
    console.log(`promote-preflight: NOT ready (${options.plan})`);
    console.log('  nothing was persisted — fix the candidate in scratch and re-run');
    process.exit(1);
  }

  console.log(`promote-preflight: ready — ${result.tasksTotal} Review Slice(s)`);
  let overBudget = 0;
  for (const task of result.parsed.tasks) {
    let packet;
    try {
      packet = compileReviewSliceExecutionPacket({ root, planPath, plan, taskId: task.id, candidateDesign });
    } catch (error) {
      console.log(`  ✗ Review Slice ${task.id}: ${error.message}`);
      overBudget += 1;
      continue;
    }
    const { cheap_ready: cheapReady, recommended_strength: strength, packet_bytes: packetBytes, reasons } = packet.routing;
    if (!cheapReady) overBudget += 1;
    console.log(
      `  Review Slice ${task.id}: cheap-ready=${cheapReady ? 'yes' : 'no'} recommended-strength=${strength} packet-bytes=${packetBytes}`
      + (reasons && reasons.length ? `\n      reasons: ${reasons.join('; ')}` : ''),
    );
  }
  if (overBudget > 0) {
    console.log('');
    console.log(`  ${overBudget} slice(s) are not cheap-ready — re-slice in scratch before recording evidence`);
    process.exit(1);
  }
  console.log('');
  console.log('  all slices within budget — record evidence, then run validate-plan for the gate of record');
}

main();
