#!/usr/bin/env node

const path = require('node:path');

const { activeReviewGuidance, decideReviewGuidance, proposeReviewGuidance } = require('./lib/review-guidance');
const {
  feedbackForFinding,
  listReviewOutcomes,
} = require('./lib/review-evidence');
const { acceptHumanReview, adjudicateFinding, recordCorrectionDirection, sliceEvidence } = require('./lib/pair-engine');
const { readCurrentWork, readJson, readState, repositoryRoot } = require('./lib/pair-store');

function parseInput(args) {
  const input = {};
  for (let index = 0; index < args.length; index++) {
    const flag = args[index];
    if (!flag.startsWith('--')) throw new Error(`unsupported argument ${flag}`);
    const value = args[index + 1];
    if (value === undefined || value.startsWith('--')) throw new Error(`${flag} requires a value`);
    index++;
    input[flag.slice(2).replace(/-([a-z])/gu, (_match, letter) => letter.toUpperCase())] = value;
  }
  return input;
}

function response(operation, repository, callback) {
  try { return { schema: 1, operation, ok: true, repository, data: callback() }; }
  catch (error) { return { schema: 1, operation, ok: false, repository, error: { code: 'PAIR_REVIEW_ERROR', message: String(error.message || error).slice(0, 1000) } }; }
}

function workId(root, input) {
  const selected = input.work || readCurrentWork(root)?.work_id;
  if (!selected || !readState(root, selected)) throw new Error('no active Pair Work');
  return selected;
}

// Only outcomes a Review Slice still stands behind are offered for staging. Listing every outcome ever
// written meant a superseded one sat in the inbox looking identical to the live one, and a disposition
// staged there recorded feedback against a finding id the current outcome does not contain — the
// adjudication gate then never completes and the slice wedges. Nothing is deleted: the superseded
// outcomes remain on disk and reachable by id through `detail`.
//
// compactAcceptedSlice now keeps review_outcome_id, so the rule is uniform: show what a slice points at.
// The one exception is a slice accepted BEFORE that fix, whose pointer is already gone — showing its
// outcomes preserves review history that would otherwise disappear from an in-flight Work.
function inbox(root, selectedWorkId) {
  const state = readState(root, selectedWorkId);
  const referenced = new Set();
  const historical = new Set();
  for (const slice of state?.slices || []) {
    if (slice.review_outcome_id) referenced.add(slice.review_outcome_id);
    else if (slice.status === 'accepted') historical.add(slice.id);
  }
  return listReviewOutcomes(root, selectedWorkId)
    .filter(outcome => (
      referenced.has(outcome.review_outcome_id) || historical.has(outcome.review_slice_id)
    ))
    .map(outcome => ({
      ...outcome,
      findings: outcome.findings.map(finding => ({
        ...finding,
        feedback: feedbackForFinding(root, selectedWorkId, finding.finding_id),
      })),
    }));
}

function operate(root, operation, input) {
  const selectedWorkId = workId(root, input);
  if (operation === 'list' || operation === 'inbox') return { work_id: selectedWorkId, outcomes: inbox(root, selectedWorkId) };
  if (operation === 'detail') {
    const id = input.id;
    for (const outcome of inbox(root, selectedWorkId)) {
      if (outcome.review_outcome_id === id) return { type: 'outcome', outcome };
      const finding = outcome.findings.find(item => item.finding_id === id);
      if (finding) return { type: 'finding', outcome_id: outcome.review_outcome_id, finding };
    }
    throw new Error(`review evidence ${id} does not exist`);
  }
  // The inbox answers "what did the reviewer find". A checkpoint awaiting human acceptance needs the
  // other half: the two diffs, the Design Check it was routed by, and the intent that steered its
  // correction. Without them acceptance is a keystroke over unread code.
  if (operation === 'checkpoint') {
    return sliceEvidence(root, { workId: selectedWorkId, sliceId: input.slice || null });
  }
  if (operation === 'accept') {
    const accepted = acceptHumanReview(root, { workId: selectedWorkId, sliceId: input.slice });
    return { work_id: accepted.work_id, lifecycle: accepted.lifecycle, next_action: accepted.next_action };
  }
  // The one channel that reaches the correcting session as intent rather than as evidence. Singular
  // and spent with the correction it steers, so a second call replaces the first rather than adding.
  if (operation === 'direct') {
    const state = recordCorrectionDirection(root, { workId: selectedWorkId, sliceId: input.slice || null, text: input.text });
    const slice = state.slices.find(item => item.correction_direction);
    return { work_id: state.work_id, review_slice_id: slice?.id || null, correction_direction: slice?.correction_direction || null };
  }
  if (operation === 'feedback') {
    // Through the engine, like accept and direct above. This called recordReviewFeedback — the raw
    // evidence writer — so adjudicating from the editor wrote durable Review Feedback and never ran the
    // reducer. The Review Slice stayed at awaiting-feedback, a second Review Feedback for the same
    // finding is refused, and `pair-loop run` returns unchanged at awaiting-human: the loop wedged with
    // no command able to move it. The status is returned so the editor can say where the slice landed.
    const state = adjudicateFinding(root, {
      workId: selectedWorkId,
      findingId: input.finding,
      disposition: input.disposition,
      reason: input.reason,
    });
    const slice = state.slices.find(item => !['queued', 'accepted'].includes(item.status));
    return {
      work_id: state.work_id,
      review_slice_id: slice?.id || null,
      review_slice_status: slice?.status || null,
      lifecycle: state.lifecycle,
      next_action: state.next_action,
    };
  }
  if (operation === 'guidance') {
    return activeReviewGuidance(root, selectedWorkId, String(input.scope || 'all').split(',').filter(Boolean));
  }
  if (operation === 'propose') {
    return proposeReviewGuidance(root, {
      workId: selectedWorkId,
      sourceFeedbackIds: String(input.feedback || '').split(',').filter(Boolean),
      scopes: String(input.scope || '').split(',').filter(Boolean),
      rule: input.rule,
      evaluation: readJson(path.resolve(input.evaluation || '')),
    });
  }
  if (operation === 'approve' || operation === 'reject') {
    return decideReviewGuidance(root, {
      workId: selectedWorkId,
      proposalId: input.proposal,
      decision: operation,
      reason: input.reason,
    });
  }
  throw new Error(`unsupported pair-review operation ${operation}`);
}

function main() {
  const args = process.argv.slice(2);
  if (args.includes('--help') || args.includes('-h')) {
    console.log('Usage: pair-review inbox|checkpoint|accept|detail|feedback|direct|guidance|propose|approve|reject [--work ID] [--slice ID] [options]');
    return;
  }
  const operation = args.shift() || 'inbox';
  let root = process.cwd();
  let result;
  try {
    root = repositoryRoot(root);
    const input = parseInput(args);
    result = response(operation, root, () => operate(root, operation, input));
  } catch (error) {
    result = response(operation, root, () => { throw error; });
  }
  process.stdout.write(`${JSON.stringify(result)}\n`);
  if (!result.ok) process.exitCode = 1;
}

if (require.main === module) main();

module.exports = { inbox, operate, parseInput, response };
