#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
case "${1:-}" in
  --fresh-from|--adopt-handover|--allow-cold-resume|--handover-now|--conversation-checkpoint|--brainstorm-checkpoint|--register-brainstorming|--enable-general-handover|--disable-general-handover|--freshness-status|--handover-help)
    exec node "$script_dir/pair-task" "$@"
    ;;
esac
exec node "$script_dir/pair-cli" "$@"
