#!/usr/bin/env node

const childProcess = require('node:child_process');
const fs = require('node:fs');

const { prepareAgentConversationStop, recordAgentConversationStop } = require('./lib/handover-state');

function readInput() {
  try { return JSON.parse(fs.readFileSync(0, 'utf8') || '{}'); } catch { return null; }
}

function repositoryRoot(cwd) {
  const result = childProcess.spawnSync('git', ['rev-parse', '--show-toplevel'], { cwd, encoding: 'utf8' });
  return result.status === 0 ? result.stdout.trim() : null;
}

function runtimeFor(input) {
  const configured = String(process.env.PAIR_HOOK_RUNTIME || input?.runtime || '').toLowerCase();
  if (configured === 'codex' || configured === 'claude') return configured;
  return process.env.CLAUDE_PROJECT_DIR || process.env.CLAUDECODE ? 'claude' : 'codex';
}

function hardStopResponse(reason) {
  return { continue: false, stopReason: reason };
}

function main() {
  if (process.env.PAIR_STOP_GATE === 'off' || process.env.CLAUDE_STOP_GATE === 'off') return;
  const input = readInput();
  if (!input || input.hook_event_name !== 'Stop' || !String(input.session_id || '').trim()) return;
  const cwd = input.cwd || input.project_dir || process.env.CLAUDE_PROJECT_DIR || process.cwd();
  const root = repositoryRoot(cwd);
  if (!root) return;
  try {
    const options = {
      runtime: runtimeFor(input),
      agentConversationId: input.session_id,
      kind: input.agent_conversation_kind || null,
      now: input.now,
    };
    const preparation = prepareAgentConversationStop(root, {
      ...options,
      transcriptPath: input.transcript_path || null,
    });
    if (preparation.status === 'recovery-unavailable') {
      process.stdout.write(`${JSON.stringify(hardStopResponse(
        'Freshness Gate could not record a complete Agent Conversation Checkpoint because this Stop event has no exact provider transcript. Record one with pair-loop --conversation-checkpoint before stopping.',
      ))}\n`);
      return;
    }
    recordAgentConversationStop(root, options);
  } catch (error) {
    const checkpointFailure = /checkpoint|not consumed/iu.test(error.message || '');
    process.stdout.write(`${JSON.stringify(hardStopResponse(checkpointFailure
      ? 'Freshness Gate stopped this turn without scheduling another old-conversation prompt: refresh the Agent Conversation Checkpoint during the one authorized turn before Stop.'
      : 'Freshness Gate stopped this registered Agent Conversation because its handover state is invalid.'))}\n`);
  }
}

if (require.main === module) main();

module.exports = { hardStopResponse, runtimeFor };
